# --- control-plane ---
DATABASE_URL=postgresql+psycopg://emailagent:emailagent@localhost:5432/emailagent
JWT_SECRET_KEY=change-me-dev-only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fernet key for encrypting OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-dev-only-32-byte-fernet-key
# Comma-separated retired keys, still valid for decrypting old data during a
# rotation window — see app/services/secrets.py. Empty until you rotate.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# "env" (default) | "vault" | "aws_kms" — the latter two are unimplemented
# stubs, see app/services/secrets.py.
SECRETS_BACKEND=env

# CELL_SERVICE_TOKEN is NOT set here — it's a per-org JWT minted by
# `python -m app.scripts.seed_dev_org` (after `alembic upgrade head`), not a
# static shared secret. Copy its printed value in below once you've run it,
# then (re)start the `openclaw` service. See docs/phase1-runbook.md. An
# earlier design used one global static secret for every tenant here, which
# was a real cross-tenant vulnerability (any cell could impersonate any
# org) — see core/security.py's CELL_SERVICE_AUDIENCE docstring.
CELL_SERVICE_TOKEN=

# --- Stripe billing (Phase 4) — see app/services/billing.py. Untested
# against a real Stripe account; use test-mode keys first. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=
BILLING_SUCCESS_URL=http://localhost:5173/billing?success=1
BILLING_CANCEL_URL=http://localhost:5173/billing?canceled=1
BILLING_PORTAL_RETURN_URL=http://localhost:5173/billing

# --- Google OAuth (Gmail) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/mailboxes/gmail/oauth/callback

# --- Microsoft OAuth (Outlook / Graph) — Phase 2 ---
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT_ID=common
MS_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/mailboxes/outlook/oauth/callback

# --- dashboard ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- gmail-mcp / outlook-mcp (agent-runtime) ---
CONTROL_PLANE_INTERNAL_URL=http://control-plane:8000

# --- Anthropic API ---
ANTHROPIC_API_KEY=

# --- Google Gemini API ---
GEMINI_API_KEY=

# --- OpenRouter API ---
OPENROUTER_API_KEY=

# --- OpenAI API ---
OPENAI_API_KEY=
