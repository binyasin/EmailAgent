// Hand-authored Phase 1+2 dev config for a single-tenant OpenClaw container.
// Mounted into the container as its ~/.openclaw/openclaw.json. Both mail
// providers are wired in; a given dev org typically only has one mailbox
// actually connected via OAuth at a time (see docs/phase1-runbook.md), but
// listing both here means either can be used without editing this file.
//
// NOTE: field names/shapes below (mcp.servers.*, agents.defaults/entries,
// toolFilter, memory.search, and where a per-agent HEARTBEAT.md is expected
// to live) are verified against docs.openclaw.ai/gateway/configuration-reference
// — see docs/openclaw-integration-notes.md for citations and any remaining
// open questions.
// The cron config for the digest skill is a separate file, see
// dev-cron-jobs.json5 in this same directory.
{
  mcp: {
    servers: {
      gmail: {
        command: "node",
        args: ["/opt/agent-runtime/mcp-servers/gmail-mcp/dist/index.js"],
        env: {
          CONTROL_PLANE_INTERNAL_URL: "${CONTROL_PLANE_INTERNAL_URL}",
          CELL_SERVICE_TOKEN: "${CELL_SERVICE_TOKEN}",
        },
        toolFilter: {
          include: [
            "search_threads",
            "get_message",
            "get_thread",
            "list_drafts",
            "create_draft",
            "update_draft",
            "list_labels",
            "create_label",
            "label_message",
            "label_thread",
            "apply_sensitive_thread_label",
            "find_availability",
            "list_events",
            "create_event",
            "notify_digest_ready",
          ],
        },
      },
      outlook: {
        command: "node",
        args: ["/opt/agent-runtime/mcp-servers/outlook-mcp/dist/index.js"],
        env: {
          CONTROL_PLANE_INTERNAL_URL: "${CONTROL_PLANE_INTERNAL_URL}",
          CELL_SERVICE_TOKEN: "${CELL_SERVICE_TOKEN}",
        },
        toolFilter: {
          include: [
            "search_threads",
            "get_message",
            "get_thread",
            "list_drafts",
            "create_draft",
            "update_draft",
            "list_labels",
            "create_label",
            "label_message",
            "label_thread",
            "apply_sensitive_thread_label",
            "find_availability",
            "list_events",
            "create_event",
            "notify_digest_ready",
          ],
        },
      },
    },
  },

  agents: {
    defaults: {
      skills: ["_shared"],
    },
    entries: {
      "dev-org-primary": {
        workspace: "/home/openclaw/workspace",
        // Expected to also pick up ./HEARTBEAT.md and the memory files
        // (style-profile.md, vip-list.md) from the workspace directory —
        // see infra/docker-compose.dev.yml for how those get bind-mounted
        // in alongside this config.
        skills: ["_shared", "triage", "draft-reply", "digest", "scheduling"],
        memory: {
          search: { sources: ["memory"] },
        },
      },
    },
  },
}
